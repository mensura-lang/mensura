import series

// The reading time is part of the identity, so at most one row exists per
// `(machine, taken_at)`.  That is what makes the window below provable.
unit Sample {
  machine: string
  taken_at: date
}

store history {
  unit { Sample }
  attr { temperature: real }
}

view reading_trend {
  history |> demote taken_at
          // For `running_peak`, whose last row is the fold itself; `previous`
          // demands nothing.
          |> assume { complete }
          |> map_bags |k, b| (
    .running_peak = series.running_max (|r| r.temperature) (|r| r.taken_at) b,
    .previous     = series.lag         (|r| r.temperature) (|r| r.taken_at) b
  )
}

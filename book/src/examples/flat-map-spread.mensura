unit Reading {
  machine: string
  ts: int
}
store readings {
  unit { Reading }
  attr {
    kelvin: real
    status: string
  }
}
view with_celsius {
  readings |> flat_map |k, r| (.celsius = r.kelvin - 273.15, ...r)
}
view recalibrated {
  readings |> flat_map |k, r| (.kelvin = r.kelvin + 0.5, ...r)
}

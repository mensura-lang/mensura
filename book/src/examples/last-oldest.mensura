unit Reading {
  machine_id: string
  taken_at:   instant
}

registry readings {
  unit { Reading }
  attr { temperature: real }
}

// The oldest reading per machine: the same reduction at the dual order.
// `desc` marks the point as descending, so the last row of that
// arrangement is the first one in time.
view first_reading {
  readings |> demote taken_at
           |> assume { complete }
           |> last (desc taken_at)
}

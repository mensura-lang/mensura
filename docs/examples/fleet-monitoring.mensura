// Fleet monitoring: the machine registry for a streaming
// predictive-maintenance example.  This file grows as the language does; today
// it holds what the current implementation compiles (scalar-key units, named
// enums, shapes, basic stores, views, and M3's dimensional units: dimensioned
// sensor columns, `import si`, and const bindings).
//
// Still to come, milestone by milestone:
//   M3+ measurement precision (a library extension of `real`, ADR 0026) and
//       measure semantics (`@additive`, ...)
//   M4  device declarations and ingestion (sensor readings land in stores)
//   M5  windowed feature views and incremental refresh
//   M6  the leak-free remaining-useful-life pipeline and its validation

// The SI unit library: symbols, prefixes, and named derived units as
// ordinary dimensioned constants (ADR 0028).  A bare import is bundled with
// the toolchain; members are qualified (`si.km`).
import bag

// The scan-derived window operations (ADR 0031, Decision 8).  `bag`'s ordered
// siblings: same combiner table, plus an order key.
import series

import si

// A dimensioned threshold constant: `kelvin` is an intrinsic base unit, so
// `overheat` is a `temperature[real]` value, usable in any view body.
let overheat { 350.0 * kelvin }

// A const function (ADR 0030): a lambda is an ordinary const value, and a
// view body applies it like any name.  The body re-types at each call
// site, so `too_hot` demands a `temperature[real]` argument here, and the
// application is beta-reduced at lowering, so the runtime never sees it.
let too_hot { |t| t > overheat }

unit Machine {
  id: string
}

enum MachineStatus {
  "operational"
  "degraded"
  "failure"
}

// A unit-agnostic structural contract: any store of commissioned equipment.
shape Commissioned {
  attr { commissioned: date }
}

// A unit-fixing contract: a table keyed by a given unit.  Claimed by the view
// below to assert its output is still keyed by `Machine` (docs/language/
// 10-views.md, "Constraining a view with a shape").
shape Tabular[U: Unit] {
  unit { U }
}

store machines : Commissioned {
  unit { Machine }
  attr {
    commissioned: date
    status: MachineStatus
    // Optional value (`?`): a machine never serviced has no last-service
    // date.  The value is missing, not absent; the row still exists
    // (ADR 0010).
    last_service: date?
  }
}

// A view derives a table from stores by a pipeline (docs/language/10-views.md).
// This one keeps only the machines needing attention: the key-first `flat_map` body
// returns the value row when degraded and the empty collection `( )` otherwise,
// so it filters without a `filter` primitive (ADR 0015).  Richer windowed
// feature views arrive with streaming (M5).
view attention_needed : Tabular[Machine] {
  machines |> flat_map |_, r| if r.status == "degraded" then r else ()
}

// Recurring observations are an entity-keyed bag store (ADR 0022): the
// machine is the identity and its readings recur, so the attributes are
// declared `attr*` (many observations per key).  Keying by the entity keeps
// a `split` routing whole machines, so tracked disjointness coincides with
// the leakage boundary; a per-machine constant (its location, say) would
// live in a companion `singletons` store such as `machines`, not in the bag.
store readings {
  unit { Machine }
  attr* {
    // A dimensioned column (ADR 0026, `11-physical-units.md`): the type
    // carries the physical dimension, magnitudes are stored normalized to
    // the SI base unit (kelvin here), and a dimension mismatch downstream
    // is a compile error.
    temperature: temperature[real]
    // A bag store carries no row order (ADR 0022), so an operation that needs
    // one names it at the operator.  This column is what a window's order key
    // reads.
    taken_at: date
  }
}

// A windowed feature view (ADR 0031, Decision 7): the ordered siblings of the
// reductions above.  Four things worth reading off it.
//
// The order is named *here*, at the operator, by the key lambda `|r| r.taken_at`;
// the store does not carry a row order.  Both lambdas take a row, one extracting
// the value to accumulate and one the key to sort by, because sorting values by
// a sibling column requires seeing the row that carries both.
//
// **A scan's order key must be tie-free, and this one is claimed rather than
// proved.**  A scan's intermediate values are determined only when at most one
// row per group shares the key (`Mensura.IsArrangement.unique`); with ties the
// answer would depend on how the rows happened to be stored.  `taken_at` is an
// ordinary attribute here, so nothing rules that out and the claim is admitted
// locally and visibly, exactly as `machine_temperature` above admits
// completeness (ADR 0017's block form, generalized as it was written to be).
//
// The stronger alternative is to *derive* the fact: make the time part of the
// identity, keying a history by `(machine, taken_at)`, and `demote` it.  The
// grading then survives the key move and the checker discharges the obligation
// with no claim at all (`Mensura.keyInjOn_demote_tag`); `book/src/examples/`
// shows that shape.  It is not used here only because `demote` is not yet
// executable, and this file is materialized end to end by the runtime tests.
//
// This is the *window* shape of `map_bags`: one output row per input row, so
// unlike the reducing view above it demands no completeness fact.  A window is
// faithful on a partial bag; only a reduction is silently wrong on one.
//
// `previous` is optional and the others are not.  That is not a choice made
// here: `series.lag` is a `prescan` at keep-right, keep-right has no identity,
// and an exclusive scan's first position folds the empty prefix, so the
// earliest reading in each machine's group has no predecessor to report
// (`Mensura.prescanBag`).
view reading_trend {
  readings |> assume { arranged } |> map_bags |k, b| (
    .running_peak = series.running_max (|r| r.temperature) (|r| r.taken_at) b,
    .previous     = series.lag         (|r| r.temperature) (|r| r.taken_at) b,
    // `lead` is `lag` at the dual key, so the last reading is the missing one.
    .next         = series.lead        (|r| r.temperature) (|r| r.taken_at) b
  )
}

// Reducing a bag folds each machine's readings, which is silently wrong on a
// partial bag, so the reducing `map_bags` demands completeness (ADR 0023).
// Until ingestion (M4) establishes the fact at the source by mechanism, the
// view assumes it, locally and visibly.  `max` preserves the dimension, so
// `max_temperature` is `temperature[real]` too.
view machine_temperature : Tabular[Machine] {
  readings |> assume { complete }
           |> map_bags |k, b| (.max_temperature = bag.max b.temperature)
}

// Dimensional arithmetic in a view body: the comparison type-checks because
// both sides are `temperature[real]`; comparing against a bare `350.0` (or
// a duration) would be a compile error.  No shape claim: the output is a
// filtered bag of readings, not a `singletons` table.
view overheating {
  readings |> flat_map |_, r| if too_hot r.temperature then r else ()
}

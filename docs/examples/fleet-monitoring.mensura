// Fleet monitoring: the machine registry for a streaming
// predictive-maintenance example.  This file grows as the language does; today
// it holds what the current implementation compiles (scalar-field units, named
// enums, shapes, stores and registries, views, M3's dimensional units, and
// M4's completeness by mechanism).
//
// Still to come, milestone by milestone:
//   M5  windowed feature views and incremental refresh
//   M6  the leak-free remaining-useful-life pipeline and its validation

// The SI unit library: symbols, prefixes, and named derived units as
// ordinary dimensioned constants (ADR 0028).  A bare import is bundled with
// the toolchain; members are qualified (`si.km`).
import bag

// The scan-derived window operations (ADR 0031, Decision 8).  `bag`'s ordered
// siblings: same combiner table, plus an order key.
import series

import si

// A dimensioned threshold constant: `kelvin` is an intrinsic base unit, so
// `overheat` is a `temperature[real]` value, usable in any view body.
let overheat { 350.0 * kelvin }

// A const function (ADR 0030): a lambda is an ordinary const value, and a
// view body applies it like any name.  The body re-types at each call
// site, so `too_hot` demands a `temperature[real]` argument here, and the
// application is beta-reduced at lowering, so the runtime never sees it.
let too_hot { |t| t > overheat }

unit Machine {
  machine_id: string
}

enum MachineStatus {
  "operational"
  "degraded"
  "failure"
}

// A unit-agnostic structural contract: any store of commissioned equipment.
shape Commissioned {
  attr { commissioned: date }
}

// A unit-fixing contract: a table keyed by a given unit.  Claimed by the view
// below to assert its output is still keyed by `Machine` (docs/language/
// 10-views.md, "Constraining a view with a shape").
shape Tabular[U: Unit] {
  unit { U }
}

store machines : Commissioned {
  unit { Machine }
  attr {
    // The civil/absolute split (ADR 0036) on one store: `commissioned` is a
    // calendar day someone wrote on paperwork, so it stays `date`;
    // `activated` is the moment the machine's telemetry came online, a
    // machine-generated event on the physical timeline, so it is an
    // `instant`.  Neither converts to the other without a zone.
    commissioned: date
    activated: instant
    status: MachineStatus
    // Optional value (`?`): a machine never serviced has no last-service
    // date.  The value is missing, not absent; the row still exists
    // (ADR 0010).
    last_service: date?
  }
}

// A view derives a table from stores by a pipeline (docs/language/10-views.md).
// This one keeps only the machines needing attention: the key-first `flat_map` body
// returns the value row when degraded and the empty collection `( )` otherwise,
// so it filters without a `filter` primitive (ADR 0015).  Richer windowed
// feature views arrive with streaming (M5).
view attention_needed : Tabular[Machine] {
  machines |> flat_map |_, r| if r.status == "degraded" then r else ()
}

// Recurring observations keyed by identity plus time: each reading's time is
// part of its identity, so at most one row exists per
// `(machine_id, taken_at)`.  That uniqueness is a *grading* seeded by the
// singletons boundary (ADR 0024), and it is what lets the windowed view below
// order by `taken_at` with no claim.  The alternative shape is an
// entity-keyed bag (`attr*`, ADR 0022), which trades that derivation
// for `assume { arranged }` at every window; `book/src/examples/` shows it.
// `taken_at` is an `instant` (ADR 0036): a reading is a moment on the
// physical timeline, and at minute cadence a calendar-day key would
// collide.  The decoder accepts RFC 3339 with an explicit offset and
// stores the normalized UTC form, so ordering by `taken_at` is
// chronological by construction.
unit Reading {
  machine_id: string
  taken_at: instant
}

// A **registry**, not a store (ADR 0033, `13-registries.md`): a reading is
// appended when it is taken and never revised, and this declaration is the
// sole intake for readings.  That mechanism establishes completeness at the
// type level **at the reading's own key**, and there it stops (ADR 0035):
// recording every reading received is not receiving every reading that
// happened, so nothing here says a machine's demoted bag is whole.
// Contrast `machines` above, a store: a machine is commissioned and its
// status changes, so rows are updated in place.
//
// The registry stays `singletons` at the reading's own key, so the ADR 0024
// grading survives and `reading_trend`'s scan still discharges tie-freedom
// structurally.  Completeness holds here trivially
// (`Mensura.fiberCompleteWrt_of_functional`), as it would for any
// `singletons` table; what the keyword buys is the append-only sole
// intake.  An `attr*` registry keyed by `Machine` would instead make
// completeness contentful at the source (the bag per machine is pinned by
// the intake), sparing `machine_temperature` its `assume { complete }`,
// but cost `assume { arranged }` at every window: one assumption for
// another.
registry readings {
  unit { Reading }
  attr {
    // A dimensioned column (ADR 0026, `11-physical-units.md`): the type
    // carries the physical dimension, magnitudes are stored normalized to
    // the SI base unit (kelvin here), and a dimension mismatch downstream
    // is a compile error.
    temperature: temperature[real]
  }
  // The gateway's documented delivery bound, made type-visible and
  // *enforced* at the intake (ADR 0037 decision 4): once the watermark
  // (the newest `taken_at` ever accepted) passes `t + 10 min`, no reading
  // at `t` will ever be accepted, and a batch that breaks the bound is
  // rejected whole.  A gateway that buffers through an outage and flushes
  // an over-age buffer surfaces here, at the boundary, instead of
  // corrupting a window already reported as final; this is the contract
  // M5's `closed` stage turns into completeness.  Registry-only: a store
  // has no sole intake to enforce it, so there the block is a compile
  // error.
  lateness { taken_at: 10.0 * si.minute }
}

// A windowed feature view (ADR 0031, Decision 7): the ordered siblings of the
// reduction below.  `demote taken_at` moves the time out of the key
// (ADR 0024), leaving a bag of readings per machine, and the order is named
// at the operator by the key lambda `|r| r.taken_at`.  Both lambdas take a
// row, one extracting the value to accumulate and one the key to sort by,
// because sorting values by a sibling column requires seeing the row that
// carries both.
//
// **A scan's order key must be tie-free, and here the fact is derived, not
// claimed.**  A scan's intermediate values are determined only when at most
// one row per group shares the key (`Mensura.IsArrangement.unique`).  The
// grading `{machine_id, taken_at}` seeded by the store survives the key
// move, so within one machine's bag the times are unique and the checker
// discharges the obligation with no ceremony
// (`Mensura.keyInjOn_demote_tag`).  A source that is genuinely a bag has no
// such grading and claims the fact with `assume { arranged }` instead,
// locally and visibly (ADR 0017's block form).
//
// **Tie-freedom is not gap-freedom**, and the checker only gives the first.
// `series.lag` means "the previous reading *in this bag*", not "the previous
// minute": if a machine was offline and its readings run 10:00, 10:01,
// 10:04, then `.previous` at 10:04 carries 10:01's temperature, and code
// differencing the two computes a rate over three minutes while reading like
// one.  Nothing here is ill-typed and the arrangement is determined; the
// window is simply faithful to the rows present rather than to a regular
// series.  Whether the ordered operations should demand contiguity is an
// open question in ADR 0035, and M5's window-closedness work is where it
// gets settled.
//
// `demote` is Tier B: the branch lineage over the finer key falls out of
// scope (ADR 0024).  That is inert here, because nothing downstream
// re-joins a `split`.
//
// This is the *window* shape of `map_bags`: one output row per input row.
// The completeness demand is nonetheless **per combiner, not per shape**
// (ADR 0037 decision 5).  `running_max` is a scan at a fold-admitting
// combiner, so it *contains* its reduction: its last row is the `bag.max`
// that `machine_temperature` computes below, and every row folds a prefix,
// silently wrong on a partial bag in exactly the reducer's sense (ADR 0023).
// So it demands the identical fact for the identical number, and the
// `assume { complete }` here mirrors the one three declarations down.  It
// was incoherent for `bag.max` to carry the obligation while `running_max`'s
// last row computed the same value without it.
//
// `lag` and `lead` demand nothing: a keep combiner's output is a claim about
// adjacency among *present* rows ("the previous reading in this bag"), which
// a partial bag represents honestly.  Splitting this view would keep them
// ceremony-free; they share `running_peak`'s view here, so they ride under
// its claim.  `reading_rate` below is the split's other half in practice:
// all keeps, no `assume`.
//
// `previous` is optional and the others are not.  That is not a choice made
// here: `series.lag` is a `prescan` at keep-right, keep-right has no identity,
// and an exclusive scan's first position folds the empty prefix, so the
// earliest reading in each machine's group has no predecessor to report
// (`Mensura.prescanBag`).
view reading_trend {
  readings |> demote taken_at
           |> assume { complete }
           |> map_bags |k, b| (
    .running_peak = series.running_max (|r| r.temperature) (|r| r.taken_at) b,
    .previous     = series.lag         (|r| r.temperature) (|r| r.taken_at) b,
    // `lead` is `lag` at the dual key, so the last reading is the missing one.
    .next         = series.lead        (|r| r.temperature) (|r| r.taken_at) b
  )
}

// The taught rate idiom (ADR 0037 decision 6), expressible because the
// scalar operators lift over optional operands (ADR 0039): both lag columns
// are optional, so the torsor difference `r.at - r.prev_at` is an optional
// `time[real]` (ADR 0036), the division is an optional `temperature/time`
// quantity, and the rate is **honestly absent** on each machine's first
// reading rather than zero-padded.  Discharge late (ADR 0039 decision 4):
// the `?` rides to the end and the serving layer renders absence; a `??`
// belongs only where its default is a true statement about the domain.
//
// Written `(v - lag v) / interval_constant` this would be silently wrong
// across the gaps the comment above describes; the point difference
// recovers the true elapsed time, which is what makes the form
// self-correcting.
//
// Every window here is a keep combiner, so the view carries no
// `assume { complete }` (ADR 0037 decision 5): `lag`'s output is a claim
// about the rows present, and the rate is a rate between recorded readings
// whether or not readings were lost upstream.
view reading_rate {
  readings
    |> demote taken_at
    |> map_bags |k, b| (
         .at       = b.taken_at,
         .temp     = b.temperature,
         .previous = series.lag (|r| r.temperature) (|r| r.taken_at) b,
         .prev_at  = series.lag (|r| r.taken_at) (|r| r.taken_at) b
       )
    |> flat_map |_, r| (
         .at   = r.at,
         .rate = (r.temp - r.previous) / (r.at - r.prev_at)
       )
}

// A boundary discharge (ADR 0039 decision 3): a comparison over an optional
// column is an optional boolean, and a filter must state the absent-row
// policy in the program.  `?? false` keeps each machine's first reading out
// of the warming set, which is the honest policy: no predecessor, no claim.
view warming {
  readings
    |> demote taken_at
    |> map_bags |k, b| (
         .at       = b.taken_at,
         .temp     = b.temperature,
         .previous = series.lag (|r| r.temperature) (|r| r.taken_at) b
       )
    |> flat_map |_, r| if (r.temp > r.previous) ?? false then r else ()
}

// Reducing folds each machine's readings, which is silently wrong on a
// partial bag, so the reducing `map_bags` demands completeness (ADR 0023).
// The registry's by-mechanism fact does not reach here: it holds at the
// reading's own key, and `demote taken_at` forfeits it on the way to the
// machine, because a reading that was never recorded is an absent key at
// the fine key and a **gap inside the machine's bag** after the coarsening
// (ADR 0035).  So the view states the claim the fold actually rests on,
// after the `demote` and visibly: no reading a machine produced went
// unrecorded.  The registry cannot supply that claim; only the deployment
// can.  `demote taken_at` also restores the `Machine` key structurally,
// which is what the `Tabular[Machine]` claim checks.  `max` preserves the
// dimension, so `max_temperature` is `temperature[real]` too.
view machine_temperature : Tabular[Machine] {
  readings |> demote taken_at
           |> assume { complete }
           |> map_bags |k, b| (.max_temperature = bag.max b.temperature)
}

// The same rollup with **no `assume` at all**, and the difference is the
// declaration rather than the pipeline.
//
// `vibrations` is an **entity-keyed bag registry** (`attr*`, ADR 0022):
// the machine is the identity and its samples recur, so the bag *is* the
// tabulation rather than something a key move produces.  Because a registry
// is the sole intake for its observations and only ever appends, the bag it
// holds for a machine is the whole bag; that is completeness established at
// the source by mechanism, and on a `bag` it is **contentful** rather than
// the trivial reading a `singletons` table carries (ADR 0033 decision 2, as
// ADR 0022 predicted).
//
// The fold below then runs at the registry's **own** key, so nothing
// coarsens and ADR 0035's clearing rule never fires.  That is the whole
// difference from `machine_temperature` above: there the fact is
// established at `(machine_id, taken_at)` and forfeited by `demote
// taken_at`, so it must be re-claimed at the key the reducer folds; here it
// is established at `machine_id`, which is already that key.
//
// Two one-word edits break it, and both should:
//
//   - change `registry` to `store` and the reducer is rejected, because a
//     store accumulates observations that can have gaps;
//   - put `taken_at` in the unit's key and `demote` it before the fold, and
//     the reducer is rejected again, because the fine-key fact says nothing
//     about the coarse bag.
unit Vibration {
  machine_id: string
}

registry vibrations {
  unit { Vibration }
  attr* {
    sampled_at: instant
    amplitude:  real
  }
}

view machine_vibration : Tabular[Vibration] {
  vibrations |> map_bags |k, b| (
    .peak_amplitude = bag.max b.amplitude,
    .sample_count   = #b.amplitude
  )
}

// Dimensional arithmetic in a view body: the comparison type-checks because
// both sides are `temperature[real]`; comparing against a bare `350.0` (or
// a duration) would be a compile error.  No shape claim: the output keeps
// the reading identity `(machine_id, taken_at)`, not a `Machine` tabulation.
view overheating {
  readings |> flat_map |_, r| if too_hot r.temperature then r else ()
}

// ---------------------------------------------------------------------------
// A rectangular coarsening: `unpivot`, then a fold with no `assume`
// ---------------------------------------------------------------------------

// Two sensors report at each slot.  The **wide** form gives each its own
// column, and both are total: every slot carries both readings.  That
// totality is the load-bearing detail below.
unit Slot {
  machine_id: string
  taken_at: instant
}

registry paired_readings {
  unit { Slot }
  attr {
    internal: temperature[real]
    external: temperature[real]
  }
}

// The average across a slot's sensors, folded with **no `assume`** even
// though the fold runs after a `demote`.  Compare `machine_temperature`
// above, which needs one for what looks like the same shape.
//
// `unpivot` is the other pair of inverse operations: where
// `promote`/`demote` move a column between the key and the attributes
// (ADR 0024), `unpivot`/`pivot` move information between **rows and
// columns**.  Folding all attribute columns (they must share a domain,
// which is why both are `temperature[real]`) spreads their names into a
// new `enum` key column and their values into one column, so the key
// becomes `(machine_id, taken_at, sensor)`.
//
// **Why no `assume` is needed here.**  Because every folded column was
// total, `unpivot` establishes `exhaustive(sensor)` (ADR 0020): every slot
// present carries a row for *every* variant of the axis.  That is exactly
// the absence ADR 0035's clearing rule guards against, so `demote sensor`
// is a coarsening with nothing to lose: the resulting bag per slot is the
// whole variant set, not a sample of it, and the reducing `map_bags`
// consumes a fact the checker derived rather than one the program claimed.
//
// The rule is narrow, and each of these breaks it, correctly:
//
//   - make either source column optional: a missing cell drops its row,
//     the variant goes absent, `exhaustive` is never established;
//   - filter the long form before demoting: `flat_map` can drop rows, so
//     it forfeits the fact;
//   - demote `taken_at` alongside `sensor`: that axis is not rectangular,
//     and the rule needs *every* demoted column to be.
view sensor_avg {
  paired_readings |> unpivot sensor reading
                  |> demote sensor
                  |> map_bags |k, b| (.average = (bag.sum b.reading) / to_real(#b))
}

// College stores: the worked example of docs/language/01-units.md and
// docs/language/02-stores.md, plus shapes from docs/language/03-shapes.md
// (unit-agnostic, and parameterised by a `string` field name).
//
// The compound units (`Course`, whose key references `Department`, and
// `Enrollment`, which references `Person` and `Course`) flatten to dotted
// key columns, and each store of a compound unit resolves its
// unit-reference fields in a `domain` block (ADR 0032).

unit Person {
  id: string
}

unit Department {
  code: string
}

unit Course {
  department: Department
  name: string
  year: int
}

unit Enrollment {
  student: Person
  course: Course
}

// Unit-agnostic: no unit clause, so any store carrying a `name: string`
// attribute conforms, whatever its unit.  `departments` claims it below.
shape Named {
  attr { name: string }
}

// A `string` parameter names the date field age is measured from, so the same
// contract fits `Person` (born on `birthdate`) and `Department` (founded on
// `foundation_day`).
shape Ageable[date_field: string] {
  attr { `{date_field}`: date }
}

// A named enumerated type: a fixed set of string-literal values, referenced by
// name below.
enum Status { "active" "inactive" }

store departments : Named, Ageable["foundation_day"] {
  unit { Department }
  attr {
    name: string
    foundation_day: date
  }
}

store persons : Ageable["birthdate"] {
  unit { Person }
  attr {
    birthdate: date
    last_name: string
  }
}

store students {
  unit { Person }
  attr {
    admission: date
    status: Status
  }
}

// A store of a compound unit: `Course.department` resolves into
// `departments`, so a course's key carries the flattened
// `department.code` column (02-stores.md).
store courses {
  unit { Course }
  domain { department: departments }
  attr {
    credits: int
  }
}

// Two levels deep: `student` resolves into `students` and `course` into
// `courses`; how `Course.department` resolves is `courses`'s own concern
// (resolution is one level deep, transitivity follows the store graph).
store student_grades {
  unit { Enrollment }
  domain {
    student: students
    course:  courses
  }
  attr {
    class_id: string
    grade:    real
  }
}

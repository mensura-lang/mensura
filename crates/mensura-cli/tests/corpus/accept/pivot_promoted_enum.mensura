// Accept: `pivot` spreads an enum index column; a stored non-index enum is
// promoted with `promote` first (composition, ADR 0020).  The sparse
// store pivots directly, with optional spread columns.
enum Metric { "lo" "hi" }
unit Obs { ts: int }
store obs { unit { Obs } attr { metric: Metric } attr { reading: real } }
view wide {
  obs |> promote metric |> pivot metric reading
}

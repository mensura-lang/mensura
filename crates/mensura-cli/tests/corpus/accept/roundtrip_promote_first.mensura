// Accept: the promote-first round trip on a singletons store (ADR 0024,
// `project_ungroup`): the source grading survives both moves and fits the
// retained key again.  Store and view claim the same all-`attr` shape, so
// the conformance check certifies the restoration: content back, and
// singletons back (a shape with no `attr*` requires singletons, ADR 0022).
unit Reading {
  ts: int
}
shape PerReading {
  unit { Reading }
  attr { machine: string }
}
store readings : PerReading { unit { Reading } attr { machine: string } }
view promoted_and_back : PerReading {
  readings |> extend_key machine |> shrink_key machine
}

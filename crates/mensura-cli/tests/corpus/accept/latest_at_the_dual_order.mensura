// Accepted: `latest (desc p)` is `latest p` at the dual order, so it keeps
// the row with the *minimal* point, the oldest row per fiber (ADR 0037
// decision 7, direction settled).
//
// The marker is the same one a scan's order key takes (ADR 0031 Decision 7,
// `accept/scan_with_a_descending_key.mensura`), reused rather than a second
// name minted: direction is a value-level marker whose whole job is this, and
// an `earliest` per point-reduction would double the vocabulary as more of
// them land.  What it costs is the reading, since "the latest by descending
// `p`" is the earliest; what it buys is one marker that generalizes.
//
// Nothing in the demands moves under it.  The dual of a total order is total
// and the dual of an injective key is injective, so totality and tie-freedom
// discharge by the same rules (here tie-freedom from the grading the `demote`
// carries, `Mensura.keyInjOn_demote_tag`), and the kept row is still
// `getLast (arrange p fiber)`, which is `Mensura.IsArrangement.unique` at the
// reversed order rather than a new theorem.  The completeness claim is the one
// the coarsening forced, exactly as in the ascending spelling
// (`reject/latest_on_a_key_column.mensura` works that through).
//
// The parentheses are load-bearing: `latest desc taken_at` flattens to two
// arguments, which is `reject/latest_desc_needs_parens.mensura`.
unit Reading {
  machine_id: string
  taken_at:   instant
}

registry readings {
  unit { Reading }
  attr { temperature: real }
}

// The newest and the oldest reading per machine: one operation, two
// directions.
view newest_reading {
  readings |> demote taken_at
           |> assume { complete }
           |> latest taken_at
}

view first_reading {
  readings |> demote taken_at
           |> assume { complete }
           |> latest (desc taken_at)
}

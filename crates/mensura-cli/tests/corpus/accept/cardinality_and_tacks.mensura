// Accepted: the cardinality operator and the four operators ADR 0031 adds
// (Decisions 6 and 9).  `#` counts a bag without demanding a total one, since
// its mapper discards the element; `<<`/`>>` are the binary minimum and
// maximum at one orderable domain; the tacks return their named side.
unit Machine {
  id: string
}

store readings {
  unit { Machine }
  attr {
    temperature: real
    checked: date?
  }
}

view summary {
  readings
    |> assume { complete }
    // `#b` is the group's row count (Decision 1); `#b.checked` counts rows
    // even though `checked` may be missing.  All three agree, since
    // projection preserves cardinality.
    |> map_bags |k, b| (.rows = #b, .n = #b.temperature, .seen = #b.checked)
}

view clamped {
  readings |> flat_map |k, r| ((
    .clamped = r.temperature << 100.0 >> 0.0,
    .left = r.temperature <: 1.0,
    .right = r.temperature :> 1.0
  ))
}

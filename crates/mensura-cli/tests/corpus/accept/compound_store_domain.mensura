// Accepted: a compound store with two-level flattening (ADR 0032).
// `Enrollment` references `Course`, which itself references `Department`;
// the key flattens to `student.id`, `course.department.code`, `course.name`,
// `course.year`, and each direct unit-reference field resolves in `domain`.
unit Person {
  id: string
}

unit Department {
  code: string
}

unit Course {
  department: Department
  name: string
  year: int
}

unit Enrollment {
  student: Person
  course: Course
}

store students {
  unit { Person }
  attr { admission: date }
}

store departments {
  unit { Department }
  attr { name: string }
}

store courses {
  unit { Course }
  domain { department: departments }
  attr { credits: int }
}

store student_grades {
  unit { Enrollment }
  domain {
    student: students
    course:  courses
  }
  attr {
    class_id: string
    grade:    real
  }
}

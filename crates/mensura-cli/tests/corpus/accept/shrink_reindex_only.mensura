// Accept: an exact extend_key/shrink_key round trip is the identity
// (ADR 0024, `project_ungroup`): the view's type is the store's own,
// singletons included, so there is nothing to discharge anywhere.
unit Reading { ts: int }
store readings { unit { Reading } attr { machine: string } }
view long_form {
  readings |> extend_key machine |> shrink_key machine
}

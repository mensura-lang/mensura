// Accept: an entity-keyed bag store (ADR 0022).  The machine is the
// identity, its readings recur (`attr*`); the `attr*` shape constrains the
// cardinality; the reducing view discharges the ADR 0023 obligation with
// `assume` until source-level completeness lands.
import bag

unit Machine { id: string }
shape SensorLog { attr* { kelvin: real } }
store readings : SensorLog {
  unit { Machine }
  attr* {
    kelvin: real
    rpm:    int
  }
}
view max_kelvin {
  readings |> assume { complete }
           |> map_bags |k, b| (.max_kelvin = bag.max b.kelvin)
}

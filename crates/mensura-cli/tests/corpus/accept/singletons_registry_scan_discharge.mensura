// Accept: the fleet example's shape in miniature.  A `singletons` registry
// keyed by (machine_id, taken_at) discharges *both* obligations with no
// ceremony: the ADR 0024 grading survives `demote` so the scan's order key
// is tie-free, and the registry's completeness is established at the source
// so the reducing `map_bags` needs no `assume`.  This is what the uniform
// rule of ADR 0033 decision 2 buys; a bag registry would trade one
// assumption for the other.
import bag
import series

unit Reading {
  machine_id: string
  taken_at:   date
}

registry readings {
  unit { Reading }
  attr {
    kelvin: real
  }
}

view reading_trend {
  readings |> demote taken_at |> map_bags |k, b| (
    .running_peak = series.running_max (|r| r.kelvin) (|r| r.taken_at) b
  )
}

view machine_peak {
  readings |> demote taken_at
           |> map_bags |k, b| (.max_kelvin = bag.max b.kelvin)
}

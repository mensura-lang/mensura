// Accepted: a view whose computed output satisfies its `: Shape` claims.
// `Tabular[Machine]` checks the output's index structurally (the `group_map`
// leaves `Machine`'s `id` as the key); `HasMax` checks a named column by type,
// ignoring the shape's `const`/`var` role, which a view does not have
// (docs/language/10-views.md, "Constraining a view with a shape").
unit Machine {
  id: string
}

shape Tabular[U: Unit] {
  unit { U }
}

shape HasMax {
  const { temp_max: real }
}

store readings {
  unit { Machine }
  var { temperature: real }
}

view machine_summary : Tabular[Machine], HasMax {
  readings |> group_map |k, g| (.temp_max = max g.temperature)
}

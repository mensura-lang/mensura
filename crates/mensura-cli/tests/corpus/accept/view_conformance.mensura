// Accepted: a view whose computed output satisfies its `: Shape` claims.
// `Tabular[Machine]` checks the output's index structurally (the `map_bags`
// leaves `Machine`'s `id` as the key); `HasMax` and `HasMin` check named
// columns by type and totality (docs/language/10-views.md, ADR 0019).
import bag

unit Machine {
  id: string
}

shape Tabular[U: Unit] {
  unit { U }
}

shape HasMax {
  attr { temp_max: real }
}

shape HasMin {
  attr { temp_min: real }
}

store readings {
  unit { Machine }
  attr { temperature: real }
}

view machine_summary : Tabular[Machine], HasMax, HasMin {
  readings |> map_bags |k, b| (.temp_max = bag.max b.temperature, .temp_min = bag.min b.temperature)
}

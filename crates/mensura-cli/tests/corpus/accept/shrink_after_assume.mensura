// Accept: assume { complete } establishes the fact, shrink_key propagates it
// to the coarser key, and the reducing group_map consumes it (ADR 0017 as
// amended by ADR 0023), bringing the bag back to singletons.
unit Reading { ts: int }
store readings { unit { Reading } attr { machine: string } attr { credits: int } }
view rollup {
  readings |> extend_key machine
           |> assume { complete }
           |> shrink_key machine
           |> group_map |k, g| (.total = sum g.credits)
}

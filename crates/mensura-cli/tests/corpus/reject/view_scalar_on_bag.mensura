// Rejected: the view body applies a scalar `+` to a bag (`b.temperature` is the
// group's bag of readings); a bag must be reduced first (09 section 5.4).
unit Machine {
  id: string
}

store readings {
  unit { Machine }
  attr { temperature: real }
}

view bad {
  readings |> map_bags |k, b| (.x = b.temperature + 1.0)
}

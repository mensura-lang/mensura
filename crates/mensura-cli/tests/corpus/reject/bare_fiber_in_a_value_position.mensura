// Rejected at resolve (typing): the group lambda's `b` is the *fiber*, a bag
// of rows (ADR 0031, Decision 1), which is not a value.  This was an error
// before the rows model too (a record is not a value), so no existing program
// reads differently; only the diagnostic's noun changed.  A column must be
// projected out, `b.temperature`.
unit Machine {
  id: string
}

store readings {
  unit { Machine }
  attr { temperature: real }
}

view bad {
  readings |> assume { complete } |> map_bags |k, b| (.t = b)
}

// Rejected at resolve (typing): an `instant` is a point, not a quantity
// (ADR 0036 decision 3), so it is not numeric and `-` does not type.  The
// torsor rules (`instant - instant : time[real]`, translation by a
// duration) land in a later slice, gated on
// `formal/Mensura/Units/Torsor.lean` (ADR 0021).
unit Machine {
  id: string
}

registry readings {
  unit { Machine }
  attr* {
    started: instant
    ended: instant
  }
}

view bad {
  readings |> map_bags |k, b| (.gap = fold `+` (|r| r.ended - r.started) b)
}

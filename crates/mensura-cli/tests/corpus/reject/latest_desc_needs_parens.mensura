// Reject: resolve.  `latest`'s point takes the `desc` marker
// (`accept/latest_at_the_dual_order.mensura`), but the marker applies to the
// point rather than sitting beside it: an unparenthesized `latest desc
// taken_at` is one application spine, so it flattens to *two* arguments and is
// an arity error.
//
// It is rejected with its own diagnostic rather than the generic arity one,
// because this is the likeliest way to spell the dual wrong and the fix is one
// pair of parentheses.
unit Reading {
  machine_id: string
  taken_at:   instant
}

registry readings {
  unit { Reading }
  attr { temperature: real }
}

view first_reading {
  readings |> demote taken_at
           |> assume { complete }
           |> latest desc taken_at
}

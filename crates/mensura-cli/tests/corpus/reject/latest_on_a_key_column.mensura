// Reject: resolve.  `latest p` reduces each fiber to the row with the
// maximal `p`, and like every reducer it needs completeness over the key
// it folds at (ADR 0023).  ADR 0037 decision 7 also specified a fused
// form for a key-borne point (`demote p` inside the operation, then the
// argmax); that form is **not shipped**, because its demand would have
// nowhere to stand:
//
//   readings |> assume { complete } |> latest taken_at
//     the claim sits at the *fine* key, which the internal coarsening
//     forfeits (ADR 0035), so it says nothing about the bag being folded;
//     compare `reject/assume_before_demote.mensura`.
//
//   readings |> latest taken_at |> assume { complete }
//     the claim comes after the fold that needed it, which is too late.
//
// So the coarsening is written out and the claim goes where it bites:
//
//   readings |> demote taken_at |> assume { complete } |> latest taken_at
//
// which is `docs/examples/fleet-monitoring.mensura`'s `newest_reading`.
// Where the point is *already* an attribute nothing coarsens and no
// claim is needed at all; that is the same file's `newest_vibration`.
import si

unit Reading {
  machine_id: string
  taken_at:   instant
}

registry readings {
  unit { Reading }
  attr { temperature: real }
}

view newest {
  readings |> latest taken_at
}

// Rejected at resolve: a spread places its fields where it is written, so
// these branches carry the same columns in different orders, and an `if`'s
// rows must share one schema, order included (ADR 0043 decision 4).
unit Machine {
  id: string
}

store readings {
  unit { Machine }
  attr { energy: real }
}

view bad {
  readings |> flat_map |k, r| if r.energy > 1.0
                              then (.hot = true, ...r)
                              else (...r, .hot = false)
}

// Rejected at resolve: the `domain` entry names `student`, but `Enrollment`
// has no unit-reference field of that name (its key is the scalar `id`), so
// there is nothing to resolve (ADR 0032).
unit Person {
  id: string
}

unit Enrollment {
  id: string
}

store students {
  unit { Person }
  attr { admission: date }
}

store grades {
  unit { Enrollment }
  domain { student: students }
  attr { class_id: string }
}

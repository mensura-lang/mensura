// Rejected at resolve: two spreads contributing the same field collide,
// even when an explicit field overrides it, so no reader has to ask which
// spread the override replaces (ADR 0043 decision 3).
unit Machine {
  id: string
}

store readings {
  unit { Machine }
  attr { energy: real }
}

view bad {
  readings |> flat_map |k, r| (.energy = 0.0, ...r, ...r)
}
